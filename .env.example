# DocMind Python Configuration

# Server Settings
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

# RAG Hyperparameters
CHUNK_SIZE=700
CHUNK_OVERLAP=100
TOP_K=5
MIN_SIMILARITY=0.0

# Embedding Model Provider (SentenceTransformers running locally by default)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Optional External LLM Integration (Leave blank to use built-in local grounded synthesizer)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_API_KEY=
